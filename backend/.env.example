DATABASE_URL=postgresql://user:password@localhost/yeikar_db
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1200
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# Motor de Cotización Inteligente (IQE)
OPENAI_API_KEY=sk-...              # API Key de OpenAI para el Vision Provider
OPENAI_VISION_MODEL=gpt-4o         # Modelo de visión a usar (gpt-4o, gpt-4o-mini, etc.)
IQE_VISION_PROVIDER=gpt            # Proveedor de visión: 'gpt' | 'gemini'
IQE_CONFIANZA_MINIMA=0.70          # Umbral mínimo de confianza para no pedir revisión humana
