DATABASE_URL=postgresql://user:password@localhost/yeikar_db
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# DEBUG=true habilita /docs y /openapi.json. En produccion debe ser false:
# sin DEBUG y sin SECRET_KEY fuerte el backend NO arranca (fail-safe).
DEBUG=false
RATE_LIMIT_REQUESTS_PER_MINUTE=1200
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
# IPs de proxies de confianza para X-Forwarded-For (coma separada).
# Vacío = se ignora XFF y se usa la IP real del socket (anti-spoofing).
# "*" = confiar en el XFF fijado por el edge de la plataforma (SOLO serverless
# tipo Vercel; nunca en un VPS/docker expuesto directamente).
FORWARDED_ALLOW_IPS=

# El Cotizador IA es 100% MANUAL (sin APIs de pago): el ERP exporta el
# contexto de negocio y una IA de navegador (ChatGPT/Gemini/Claude) devuelve
# la estructura en JSON. No se requieren claves de OpenAI ni Gemini.
