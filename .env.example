# ──────────────────────────────────────────────────────────────────────────
# YEIKAR ERP — Variables de entorno de ejemplo
# Copia este archivo a .env y cambia los valores por los reales.
# NUNCA subas el .env real a git.
# ──────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────
# ⚠️ En producción usa una contraseña fuerte (no yeikar123)
DB_USER=yeikar
DB_PASSWORD=yeikar123
DB_NAME=yeikar_db

# URL completa (usada directamente por el backend si no usas docker-compose)
DATABASE_URL=postgresql://yeikar:yeikar123@localhost:5432/yeikar_db

# ── JWT ───────────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# Obligatorio en producción: sin SECRET_KEY fuerte el backend NO arranca.
SECRET_KEY=cambia-esto-en-produccion-usa-minimo-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Modo debug ────────────────────────────────────────────────────────────
# DEBUG=true habilita /docs y /openapi.json (SOLO desarrollo)
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma.
# Con nginx como proxy (mismo origen) no aplica CORS; es para accesos directos.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── VPS: dominio del API + proxy de confianza ────────────────────────────
# Dominio que Caddy sirve con HTTPS automático (ver Caddyfile):
#   - Producción: API_DOMAIN=api.tudominio.com
#   - Prueba local sin dominio: API_DOMAIN=:80 (solo HTTP)
API_DOMAIN=:80
# IP fija de Caddy en la red de compose (pinneada en docker-compose.yml).
# El backend solo cree en X-Forwarded-For cuando el peer es esta IP.
FORWARDED_ALLOW_IPS=10.200.0.10

# ── Backup offsite (Cloudflare R2) ────────────────────────────────────────
# Copia diaria de backups a un bucket externo (anti-ransomware).
# Todos vacíos = el servicio offsite-sync queda inactivo (solo backup local).
# Guía: DEPLOY.md paso 7. R2_BUCKET solo se usa si las credenciales existen.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yeikar-backups

# ── Seguridad de login / rate limit ───────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=1200
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
# FORWARDED_ALLOW_IPS se declara arriba (sección VPS: 10.200.0.10).
# ⚠️ No lo repitas aquí: en un .env gana la ÚLTIMA aparición, y si
# quedara vacío el backend ignoraría X-Forwarded-For → como todo el
# tráfico pasa por Caddy, TODOS los usuarios verían la misma IP y el
# bloqueo de login (LOGIN_MAX_INTENTOS) los bloquearía a la vez.

# ── Frontend (Vite, solo desarrollo) ──────────────────────────────────────
VITE_API_URL=http://localhost:8000
