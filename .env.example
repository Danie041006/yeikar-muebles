# ──────────────────────────────────────────────────────────────────────────
# YEIKAR ERP — Variables de entorno de ejemplo
# Copia este archivo a .env y cambia los valores por los reales.
# NUNCA subas el .env real a git.
# ──────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────
# ⚠️ En producción usa una contraseña fuerte (no yeikar123)
DB_USER=yeikar
DB_PASSWORD=yeikar123
DB_NAME=yeikar_db

# URL completa (usada directamente por el backend si no usas docker-compose)
DATABASE_URL=postgresql://yeikar:yeikar123@localhost:5432/yeikar_db

# ── JWT ───────────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# Obligatorio en producción: sin SECRET_KEY fuerte el backend NO arranca.
SECRET_KEY=cambia-esto-en-produccion-usa-minimo-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Modo debug ────────────────────────────────────────────────────────────
# DEBUG=true habilita /docs y /openapi.json (SOLO desarrollo)
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma.
# Con nginx como proxy (mismo origen) no aplica CORS; es para accesos directos.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Seguridad de login / rate limit ───────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=1200
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
# IPs de proxies de confianza para X-Forwarded-For (coma separada).
# Vacío = se ignora XFF y se usa la IP real del socket (anti-spoofing).
FORWARDED_ALLOW_IPS=

# ── Frontend (Vite, solo desarrollo) ──────────────────────────────────────
VITE_API_URL=http://localhost:8000
